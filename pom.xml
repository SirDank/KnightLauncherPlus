<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.lucasluqui</groupId>
  <artifactId>KnightLauncher</artifactId>
  <packaging>jar</packaging>
  <version>2.9.1-SNAPSHOT</version>

  <name>Knight Launcher</name>
  <description>Open source game launcher for Spiral Knights.</description>

  <url>https://github.com/SirDank/KnightLauncherPlus</url>
  <issueManagement>
    <url>https://github.com/SirDank/KnightLauncherPlus/issues</url>
  </issueManagement>

  <developers>
    <developer>
      <id>lucasluqui</id>
      <name>Lucas Allegri</name>
      <email>contact@lucasluqui.com</email>
    </developer>
  </developers>

  <licenses>
    <license>
      <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
    </license>
  </licenses>

  <properties>
    <!--
      The Java version the launcher is built for and runs on. Older Java installs that start the launcher make it
      restart on a runtime of this version, which it downloads from the CDN if needed.
    -->
    <launcher.java.version>25</launcher.java.version>

    <env>dev</env>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.5</version>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>33.7.1-jre</version>
    </dependency>
    <!--
      The regular Guice jar bundles an ASM that can't read Java 25 class files, so use the jar without
      it ('classes') and bring in a recent ASM ourselves.
    -->
    <dependency>
      <groupId>com.google.inject</groupId>
      <artifactId>guice</artifactId>
      <version>7.0.0</version>
      <classifier>classes</classifier>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>9.11.1</version>
    </dependency>
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
      <version>3.7.1</version>
    </dependency>
    <dependency>
      <groupId>com.github.vatbub</groupId>
      <artifactId>mslinks</artifactId>
      <version>1.0.6.2</version>
    </dependency>
    <dependency>
      <groupId>net.lingala.zip4j</groupId>
      <artifactId>zip4j</artifactId>
      <version>2.11.6</version>
    </dependency>
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <version>20260719</version>
    </dependency>
    <dependency>
      <groupId>com.github.jiconfont</groupId>
      <artifactId>jiconfont-swing</artifactId>
      <version>1.0.1</version>
    </dependency>
    <dependency>
      <groupId>com.github.jiconfont</groupId>
      <artifactId>jiconfont-font_awesome</artifactId>
      <version>4.7.0.1</version>
    </dependency>
    <dependency>
      <groupId>com.samskivert</groupId>
      <artifactId>samskivert</artifactId>
      <version>1.9</version>
    </dependency>
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.21.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
      <version>1.15.0</version>
    </dependency>
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark</artifactId>
      <version>0.32.0</version>
    </dependency>
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark-ext-autolink</artifactId>
      <version>0.32.0</version>
    </dependency>
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
      <version>0.32.0</version>
    </dependency>
    <dependency>
      <groupId>com.jhlabs</groupId>
      <artifactId>filters</artifactId>
      <version>2.0.235-1</version>
    </dependency>
    <dependency>
      <groupId>com.github.oshi</groupId>
      <artifactId>oshi-core</artifactId>
      <version>6.11.1</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.1.0-alpha1</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.14.3</version>
      <scope>test</scope>
    </dependency>

    <!-- The built-in Tortodrone server stores accounts, characters, and world state in SQLite (KnightLauncher/server/data/tortodrone.db). -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.50.3.0</version>
    </dependency>

    <!--
      Compile-time only, for the skgfx agent (rsrc/modules/skgfx/skgfx-agent.jar): it runs inside the game's JVM,
      which has the game's own LWJGL 3 on the classpath, so nothing of this ships in the launcher.
    -->
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl</artifactId>
      <version>3.3.6</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-glfw</artifactId>
      <version>3.3.6</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-opengl</artifactId>
      <version>3.3.6</version>
      <scope>provided</scope>
    </dependency>

    <!-- Start of local dependencies, found in 'lib' directory. -->
    <!-- Make sure to run 'mvn validate' at least once to install all the local dependencies below. -->
    <dependency>
      <groupId>net.arikia.dev</groupId>
      <artifactId>discord-rpc</artifactId>
      <version>20220830184500</version>
    </dependency>
    <dependency>
      <groupId>net.sf</groupId>
      <artifactId>image4j</artifactId>
      <version>0.7.2</version>
    </dependency>

  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <sourceDirectory>src/main/java</sourceDirectory>

    <resources>
      <resource>
        <directory>./</directory>
        <includes>
          <include>deploy.properties</include>
        </includes>
        <filtering>true</filtering>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>src/main/resources/rsrc/build</directory>
        <filtering>true</filtering>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <version>3.1.4</version>
        <executions>
          <execution>
            <id>local-install-discord-rpc</id>
            <phase>validate</phase>
            <goals>
              <goal>install-file</goal>
            </goals>
            <configuration>
              <groupId>net.arikia.dev</groupId>
              <artifactId>discord-rpc</artifactId>
              <version>20220830184500</version>
              <file>${basedir}/lib/discord-rpc-20220830184500.jar</file>
            </configuration>
          </execution>
          <execution>
            <id>local-install-image4j</id>
            <phase>validate</phase>
            <goals>
              <goal>install-file</goal>
            </goals>
            <configuration>
              <groupId>net.sf</groupId>
              <artifactId>image4j</artifactId>
              <version>0.7.2</version>
              <file>${basedir}/lib/image4j-0.7.2.jar</file>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <encoding>${project.build.sourceEncoding}</encoding>
        </configuration>
      </plugin>
      <!--
        Packages the skgfx javaagent into the resources before the launcher jar is assembled, so the launcher can
        extract it to KnightLauncher/modules/skgfx/ like the other bundled modules.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <executions>
          <execution>
            <id>skgfx-agent</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <finalName>skgfx</finalName>
              <classifier>agent</classifier>
              <outputDirectory>${project.build.outputDirectory}/rsrc/modules/skgfx</outputDirectory>
              <includes>
                <include>com/lucasluqui/skgfx/**</include>
              </includes>
              <archive>
                <manifestEntries>
                  <Premain-Class>com.lucasluqui.skgfx.SkGfxAgent</Premain-Class>
                  <Can-Retransform-Classes>true</Can-Retransform-Classes>
                </manifestEntries>
              </archive>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.8.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <descriptors>
            <descriptor>src/assembly/jar-with-dependencies.xml</descriptor>
          </descriptors>
          <archive>
            <manifest>
              <mainClass>com.lucasluqui.launcher.Main</mainClass>
            </manifest>
          </archive>
          <appendAssemblyId>false</appendAssemblyId>
        </configuration>
      </plugin>
      <!--
        Registers 'src/main/java8' as a source directory, mostly so IDEs pick it up.
        It's compiled on its own for Java 8 though, see the compiler plugin below.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>add-java8-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/src/main/java8</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <encoding>UTF-8</encoding>
          <release>${launcher.java.version}</release>
        </configuration>
        <executions>
          <!--
            The regular compilation only covers 'src/main/java'. Without this, it'd also pick up 'src/main/java8'
            (added above) and compile it for Java 25, replacing its Java 8 classes.
          -->
          <execution>
            <id>default-compile</id>
            <configuration>
              <compileSourceRoots>
                <compileSourceRoot>${project.basedir}/src/main/java</compileSourceRoot>
              </compileSourceRoots>
            </configuration>
          </execution>
          <!--
            Everything in 'src/main/java8' is compiled for Java 8, and before the rest so it can use it.
            That's the jar's entry point (com.lucasluqui.launcher.Main), which has to run on whatever Java the
            launcher gets started with (often Java 8) and restart it on Java 25 if needed.
          -->
          <execution>
            <id>compile-java8</id>
            <phase>process-sources</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <release>8</release>
              <compileSourceRoots>
                <compileSourceRoot>${project.basedir}/src/main/java8</compileSourceRoot>
              </compileSourceRoots>
              <compilerArgs>
                <!-- Don't warn about Java 8 being an obsolete target. -->
                <arg>-Xlint:-options</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
