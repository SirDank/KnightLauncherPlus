{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build & Deploy",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build_and_deploy.sh",
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/build_and_deploy.ps1"
        ]
      },
      "linux": {
        "command": "${workspaceFolder}/scripts/build_and_deploy.sh"
      },
      "osx": {
        "command": "${workspaceFolder}/scripts/build_and_deploy.sh"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build, Deploy & Run",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build_and_deploy.sh",
      "args": ["--run"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/build_and_deploy.ps1",
          "-Run"
        ]
      },
      "linux": {
        "command": "${workspaceFolder}/scripts/build_and_deploy.sh",
        "args": ["--run"]
      },
      "osx": {
        "command": "${workspaceFolder}/scripts/build_and_deploy.sh",
        "args": ["--run"]
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy Only (Skip Build)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build_and_deploy.sh",
      "args": ["--skip-build"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/build_and_deploy.ps1",
          "-SkipBuild"
        ]
      },
      "linux": {
        "command": "${workspaceFolder}/scripts/build_and_deploy.sh",
        "args": ["--skip-build"]
      },
      "osx": {
        "command": "${workspaceFolder}/scripts/build_and_deploy.sh",
        "args": ["--skip-build"]
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy Dry Run",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build_and_deploy.sh",
      "args": ["--dry-run"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/build_and_deploy.ps1",
          "-DryRun"
        ]
      },
      "linux": {
        "command": "${workspaceFolder}/scripts/build_and_deploy.sh",
        "args": ["--dry-run"]
      },
      "osx": {
        "command": "${workspaceFolder}/scripts/build_and_deploy.sh",
        "args": ["--dry-run"]
      },
      "problemMatcher": []
    },
    {
      "label": "Check Updates (KL_Update)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/KL_Update.sh",
      "windows": {
        "command": "cmd.exe",
        "args": ["/c", "${workspaceFolder}\\scripts\\KL_Update.bat"]
      },
      "linux": {
        "command": "${workspaceFolder}/scripts/KL_Update.sh"
      },
      "osx": {
        "command": "${workspaceFolder}/scripts/KL_Update.sh"
      },
      "problemMatcher": []
    },
    {
      "label": "Maven: Test",
      "type": "shell",
      "command": "./mvnw",
      "args": ["test"],
      "windows": {
        "command": ".\\mvnw.cmd"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Maven: Package (Prod)",
      "type": "shell",
      "command": "./mvnw",
      "args": ["-Denv=prod", "-DskipTests", "clean", "package"],
      "windows": {
        "command": ".\\mvnw.cmd"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
